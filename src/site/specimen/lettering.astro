---
// Lettering: the four faces the pen strokes from one skeleton alphabet, each lettering a title from the shop's racks,
// so the section hands on to the records in use at the end of the sheet.
import { Lettering } from "@/fineliner/drawing/lettering"
import type { FaceName } from "@/fineliner/pen"
import SheetSection from "./sheet-section.astro"

const FACES: [FaceName, string, string, string][] = [
  ["liner", "Liner", "One monoline, a short serif across every free end.", "Paper Moons"],
  ["stilt", "Stilt", "Liner drawn tall and narrow, for spines and signs.", "Quiet Hours"],
  ["ribbon", "Ribbon", "Two outlines a stroke apart, filled with the wash.", "Side Streets"],
  ["tramline", "Tramline", "Three parallel lines and no serifs.", "Pétillant"],
]
---

<SheetSection id="lettering">
  <ul class="m-0 grid list-none gap-y-section p-0">
    {
      FACES.map(([face, name, note, words]) => (
        <li class="grid items-end gap-x-line gap-y-tight lg:grid-cols-9">
          <Lettering
            text={words}
            face={face}
            seed={`sheet-${face}`}
            className="block h-14 max-w-full lg:col-span-6 [&>svg]:h-full [&>svg]:w-auto [&>svg]:max-w-full"
          />
          <div class="lg:col-span-3">
            <p class="m-0 text-lead leading-subhead">{name}</p>
            <p class="m-0 text-small leading-small text-pen-quiet">{note}</p>
          </div>
        </li>
      ))
    }
  </ul>
</SheetSection>
