---
// Lettering on the sheet: the three Fineliner Naïve faces, one title each at one size with the face's name and what
// it is beside it, and a faint rule between faces. Their four styles, colours, files, letters and the set they share
// have a page of their own (/lettering), which the section ends by pointing to.
import { Lettering } from "@/fineliner/drawing/lettering"
import { frameVars, seedOf } from "@/fineliner/pen"
import { FACES } from "@/site/lettering/faces"
import SheetSection from "./sheet-section.astro"

const rule = (key: string) => frameVars(seedOf(`lettering-rule-${key}`))
---

<SheetSection id="lettering">
  <div class="grid gap-y-section">
    {
      FACES.map(({ face, sample, name, about }) => (
        <>
          <article class="grid items-start gap-x-line gap-y-tight lg:grid-cols-9" aria-label={name}>
            <Lettering
              text={sample}
              face={face}
              className="block text-[clamp(2.75rem,7vw,4.5rem)] whitespace-nowrap lg:col-span-6"
            />
            <div class="lg:col-span-3">
              <h3 class="m-0 text-lead leading-subhead">{name}</h3>
              <p class="m-0 text-small leading-small text-pen-quiet">{about}</p>
            </div>
          </article>
          <div class="rule text-pen-faint" style={rule(face)} aria-hidden="true" />
        </>
      ))
    }
    <p class="m-0 max-w-measure text-small leading-small">
      <a href="/lettering">Every face in Regular, Bold, Italic and Bold Italic</a>, Inline in colour, their files and
      the 197 characters they share, with a tester for your own words.
    </p>
  </div>
</SheetSection>
