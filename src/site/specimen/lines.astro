---
// The line: the three things the pen draws round or fills in the interface (a frame, a pocket of ink, a sheet that
// floats with the cartoonist's shadow), each in the calm hand above the lively one, so the difference reads down a
// column. Each takes its wobble and corner overshoot from its own seed. Then the marks the pen puts down.
import { Circled, PenMark } from "@/fineliner/drawing/pen-mark"
import { frameVars, seedOf, type MarkName } from "@/fineliner/pen"
import SheetSection from "./sheet-section.astro"

const f = (seed: string) => frameVars(seedOf(seed))
const HANDS = [
  ["calm", "Calm"],
  ["lively", "Lively"],
] as const
const PARTS = [
  ["frame", "A drawn frame", "Four strokes whose ends cross or fall short."],
  ["pocket", "A pocket of ink", "The one place on a form the eye should land."],
  ["sheet", "A sheet that floats", "A frame and a second line: the shadow."],
] as const
const MARKS: [MarkName, string][] = [
  ["tick", "Tick"],
  ["ring", "Ring"],
  ["dot", "Dot"],
  ["underline", "Underline"],
  ["strike", "Strike"],
  ["arrow", "Arrow"],
  ["chevron", "Chevron"],
  ["pill", "Pill"],
]
---

<SheetSection id="line">
  <div class="grid gap-x-line gap-y-section sm:grid-cols-3 lg:grid-cols-9">
    {
      PARTS.map(([part, title, note]) => (
        <div class="grid content-start gap-snug lg:col-span-3">
          <div>
            <h3 class="m-0 text-lead leading-subhead">{title}</h3>
            <p class="m-0 mt-hair text-small leading-small text-pen-quiet">{note}</p>
          </div>
          {HANDS.map(([hand, name]) => (
            <div data-hand={hand} class="grid justify-items-start gap-hair">
              <span class="label text-pen-quiet">{name}</span>
              {part === "frame" && (
                <span class="frame inline-flex h-control w-[12rem] items-center px-tight text-ui" style={f(`${hand}-field`)}>
                  Maya Singh
                </span>
              )}
              {part === "pocket" && (
                <span class="relative isolate inline-flex h-control items-center px-snug text-ui text-paper">
                  <i class="ink-fill" style={f(`${hand}-fill`)} />
                  Book session
                </span>
              )}
              {part === "sheet" && (
                <span class="frame relative mb-hair block w-[12rem] bg-paper p-tight text-small leading-small" style={f(`${hand}-sheet`)}>
                  <span class="pen-shadow" aria-hidden="true" />
                  Take it off the shelf?
                </span>
              )}
            </div>
          ))}
        </div>
      ))
    }
  </div>

  <div class="grid gap-snug">
    <div>
      <h3 class="m-0 text-lead leading-subhead">Marks</h3>
      <p class="m-0 mt-hair max-w-measure text-small leading-small text-pen-quiet">
        Put down by the pen for a choice, a state or <Circled seed="marks-note">a note</Circled>, quick as a tick.
      </p>
    </div>
    <ul class="m-0 grid list-none grid-cols-4 gap-x-line gap-y-snug p-0 sm:grid-cols-8">
      {
        MARKS.map(([name, label]) => (
          <li class="grid justify-items-start gap-hair">
            <PenMark name={name} seed={`sheet-${name}`} className="h-8 w-10" />
            <span class="label text-pen-quiet">{label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</SheetSection>
