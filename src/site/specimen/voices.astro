---
// The voices and the type scale: the serif to read, the typewriter for menus and labels, the hand for asides.
import SectionHead from "./section-head.astro"

const SCALE = [
  ["display", "text-display leading-display", "Quietly strange"],
  ["title", "text-title leading-heading", "Listening room"],
  ["h1", "text-h1 leading-heading", "Thursday evenings"],
  ["h2", "text-h2 leading-heading", "Bring a record you love"],
  ["lead", "text-lead leading-lead", "And one you have never played."],
  ["body", "text-body leading-body", "We put them on in the order they arrive."],
  ["small", "text-small leading-small", "Doors at seven; the second side starts at eight."],
] as const
const MENU = [
  ["Bread, cultured butter", "45"],
  ["Smoked trout, rye, dill", "95"],
  ["Pét-nat by the glass", "80"],
]
---

<section class="mx-auto mt-page max-w-[76rem] px-snug sm:px-line" aria-labelledby="voices">
  <SectionHead n={2} id="voices" title="Voices" />
  <div class="grid gap-section lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]">
    <div class="grid gap-snug">
      <h3 class="label m-0">Read · Newsreader</h3>
      {
        SCALE.map(([step, classes, text]) => (
          <div class="grid gap-x-snug sm:grid-cols-[4.5rem_minmax(0,1fr)] sm:items-baseline">
            <span class="label">{step}</span>
            <p class={`m-0 ${classes}`}>{text}</p>
          </div>
        ))
      }
      <p class="m-0 mt-snug max-w-measure">
        Bring a record you love and one you have never played. We put them on in the order they arrive, with the
        lights low and the windows open, and nobody talks over the second side. The measure holds about seventy-five
        characters, so a paragraph reads without the eye losing its place.
      </p>
    </div>
    <div class="grid content-start gap-line">
      <div class="grid gap-tight">
        <h3 class="label m-0">Type · Courier Prime</h3>
        <ul class="m-0 grid max-w-[26rem] list-none gap-hair p-0 font-type">
          {
            MENU.map(([dish, price]) => (
              <li class="flex items-baseline gap-tight">
                {dish}
                <span class="dots" aria-hidden="true" />
                <span class="tabular-nums">{price}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="grid gap-tight">
        <h3 class="label m-0">Labels</h3>
        <p class="label m-0">Side A · 33⅓ rpm · Nº 0412</p>
        <p class="label m-0" data-labels="type">Side A · 33⅓ rpm · Nº 0412</p>
      </div>
      <div class="grid gap-tight">
        <h3 class="label m-0">Hand · Gaegu</h3>
        <p class="m-0 -rotate-1 font-hand text-lead leading-[1.1]">the good chairs are by the window</p>
      </div>
    </div>
  </div>
</section>

<style>
  .dots {
    flex: 1;
    border-bottom: 1.5px dotted currentColor;
    translate: 0 -0.3em;
  }
</style>
