---
// Paper and pens. Stock colours are read from stocks.css at build time, so the specimen cannot drift from the
// tokens; pens are live chips that follow the page's paper and theme.
import stocksCss from "@/fineliner/styles/stocks.css?raw"
import { APPEARANCE } from "@/fineliner/theme"
import SectionHead from "./section-head.astro"

const block = (selector: string) => {
  const start = stocksCss.indexOf(`${selector} {`)
  const body = start < 0 ? "" : stocksCss.slice(start, stocksCss.indexOf("}", start))
  return Object.fromEntries([...body.matchAll(/(--[\w-]+):\s*(#[0-9a-f]{6})/gi)].map((m) => [m[1], m[2]]))
}
const root = block(':root[data-stock="recycled"]')
const night = block(':root[data-theme="night"]')
const STOCKS = APPEARANCE.stock.map((stock) => {
  const day = stock === "recycled" ? root : block(`:root[data-stock="${stock}"]`)
  const dark = stock === "recycled" ? night : block(`:root[data-stock="${stock}"][data-theme="night"]`)
  return { stock, day: day["--paper"] ?? "", night: dark["--paper"] ?? "" }
})
const NAMES: Record<string, string> = { black: "Soft black" }
const name = (pen: string) => NAMES[pen] ?? pen.charAt(0).toUpperCase() + pen.slice(1)
---

<section class="mx-auto mt-page max-w-[76rem] px-snug sm:px-line" aria-labelledby="paper">
  <SectionHead n={1} id="paper" title="Paper and pens" />
  <div class="grid gap-line md:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)]">
    <div>
      <h3 class="label m-0 mb-snug">Stocks</h3>
      <ul class="m-0 grid list-none gap-snug p-0">
        {
          STOCKS.map(({ stock, day, night }) => (
            <li class="flex items-center gap-snug">
              <span class="flex">
                <span class="block size-12 border border-pen/30" style={`background:${day}`} />
                <span class="block size-12 border border-pen/30" style={`background:${night}`} />
              </span>
              <span>
                <span class="block">{stock.charAt(0).toUpperCase() + stock.slice(1)}</span>
                <span class="block font-type text-small tabular-nums">
                  {day} · {night}
                </span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h3 class="label m-0 mb-snug">Pens on this paper</h3>
      <ul class="m-0 grid list-none grid-cols-[repeat(auto-fill,minmax(7.5rem,1fr))] gap-snug p-0">
        {
          APPEARANCE.pen.map((pen) => (
            <li data-pen={pen} class="grid gap-hair">
              <span class="block size-10 rounded-full bg-pen" />
              <span>{name(pen)}</span>
            </li>
          ))
        }
        <li class="grid gap-hair">
          <span class="block size-10 rounded-full bg-wash"></span>
          <span>Wash <span class="text-small">(art only)</span></span>
        </li>
        <li class="grid gap-hair">
          <span class="block size-10 rounded-full bg-correction"></span>
          <span class="text-correction">Correction</span>
        </li>
      </ul>
    </div>
  </div>
</section>
