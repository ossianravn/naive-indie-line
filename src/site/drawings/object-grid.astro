---
// A grid of library drawings, each opening at the desk with the same seed. Each row of the grid is two shared tracks,
// drawings then names: the drawings stand on one line and the names start on the next, whatever each drawing's height
// or each name's length.
import { Drawing } from "@/fineliner/drawing/drawing"
import type { DrawingObject } from "@/fineliner/pen"

interface Props {
  objects: DrawingObject[]
  seed: string
}
const { objects, seed } = Astro.props
---

<ul class="m-0 grid list-none grid-cols-3 gap-x-snug gap-y-line p-0 sm:grid-cols-[repeat(auto-fill,minmax(9rem,1fr))] sm:gap-x-line">
  {objects.map((o) => (
    <li class="row-span-2 grid grid-rows-subgrid">
      <a
        href={`/desk?seed=${seed}&object=${o.id}`}
        class="group row-span-2 grid grid-rows-subgrid justify-items-center gap-y-tight no-underline"
      >
        <Drawing
          object={o.id}
          seed={seed}
          title=""
          className="w-full self-end [&>svg]:max-h-44"
        />
        <span class="label self-start text-center decoration-1 underline-offset-[0.2em] group-hover:underline">
          {o.name}
        </span>
      </a>
    </li>
  ))}
</ul>
