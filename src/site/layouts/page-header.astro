---
// The one page head for the site's working pages (components, blocks, drawings, studio, 404): the title and a lead
// paragraph at the reading measure, nothing above the title (the site's nav already says where the page sits). The
// title and the lead keep one size and one position on every page, so moving between pages never shifts them. An
// optional `aside` slot sits beside the head from md (the 404's drawing); the home page, the specimen, the lettering
// page and the desk have heads of their own. Inside a column of its own (`contained={false}`) it drops the site
// container but keeps its top.
//
//   <PageHeader title="Drawings">The lead paragraph.</PageHeader>

interface Props {
  title: string
  /** false inside a page's own column that already sits in the site's container (a docs component page). */
  contained?: boolean
}
const { title, contained = true } = Astro.props
const aside = Astro.slots.has("aside")
---

<div
  class:list={[
    "pt-section",
    contained && "mx-auto max-w-[76rem] px-snug sm:px-line",
    aside &&
      "grid items-start gap-x-page gap-y-line md:grid-cols-[minmax(0,1fr)_16rem]",
  ]}
>
  <div class="min-w-0" data-page-header>
    <h1 class="m-0 text-title leading-heading">{title}</h1>
    {Astro.slots.has("default") && (
      <p class="m-0 mt-tight max-w-measure text-body leading-body sm:text-lead sm:leading-lead">
        <slot />
      </p>
    )}
  </div>
  {aside && <slot name="aside" />}
</div>
