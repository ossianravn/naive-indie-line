---
// Listening Room's own frame: a product, not the docs. Its sections in a sidebar, its person, a quiet link back to
// Fineliner.
import "@/fineliner/pen/objects"
import "@/fineliner/pen/objects/rooms"
import "@/fineliner/styles/fineliner.css"
import { FinelinerDefs } from "@/fineliner/defs/fineliner-defs"
import { appearanceScript } from "@/fineliner/theme/appearance-script"
import { ListeningRoomShell, type Section } from "@/site/listening-room/shell"

interface Props {
  title: string
  /** The sidebar entry this page belongs to. Sign-in has none, and no sidebar. */
  section?: Section
}
const { title, section } = Astro.props
const shareImage = new URL("/og/listening-room.png", Astro.site ?? Astro.url)
  .href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Every page letters something in Naïve Sans; the build serves it as a file (astro.config.mjs). -->
    <link
      rel="preload"
      href="/fonts/fineliner-naive-sans.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title} · Listening Room</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta
      name="description"
      content="Listening Room, a record shop with a room to listen in: a demo product built with Fineliner."
    />
    <meta property="og:title" content={`${title} · Listening Room`} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline set:html={appearanceScript()} />
  </head>
  <body>
    <FinelinerDefs />
    <a
      class="label absolute -left-[999px] top-2 z-30 bg-pen px-tight py-hair text-paper focus:left-2"
      href="#main"
    >
      Skip to content
    </a>
    {section ? (
      <ListeningRoomShell current={section} client:load>
        <slot />
      </ListeningRoomShell>
    ) : (
      <main id="main">
        <slot />
      </main>
    )}
    <script>
      // Drawings rendered at build time carry their first take; this draws the others where line boil shows them.
      import { boilTakesIn } from "@/fineliner/drawing/drawing-takes"
      boilTakesIn(document, () =>
        Promise.all([
          import("@/fineliner/pen/objects"),
          import("@/fineliner/pen/objects/rooms"),
        ]),
      )
    </script>
  </body>
</html>
