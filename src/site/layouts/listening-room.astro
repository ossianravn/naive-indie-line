---
// Listening Room's own frame: a product, not the docs. Its sections in a sidebar, its person, a quiet link back to
// Fineliner.
import "@/fineliner/styles/fineliner.css"
import { FinelinerDefs } from "@/fineliner/defs/fineliner-defs"
import { appearanceScript } from "@/fineliner/theme/appearance-script"
import { ListeningRoomShell, type Section } from "@/site/listening-room/shell"

interface Props {
  title: string
  /** The sidebar entry this page belongs to. Sign-in has none, and no sidebar. */
  section?: Section
}
const { title, section } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Listening Room</title>
    <meta
      name="description"
      content="Listening Room, a record shop with a room to listen in: a demo product built with Fineliner."
    />
    <script is:inline set:html={appearanceScript()} />
  </head>
  <body>
    <FinelinerDefs />
    <a
      class="label absolute -left-[999px] top-2 z-30 bg-pen px-tight py-hair text-paper focus:left-2"
      href="#main"
    >
      Skip to content
    </a>
    {section ? (
      <ListeningRoomShell current={section} client:load>
        <slot />
      </ListeningRoomShell>
    ) : (
      <main id="main">
        <slot />
      </main>
    )}
  </body>
</html>
