---
// The site's page frame: pre-paint appearance, shared filters, header and footer.
import "@/fineliner/pen/objects"
import "@/fineliner/pen/objects/rooms"
import "@/fineliner/styles/fineliner.css"
import "@/site/site.css"
import { FinelinerDefs } from "@/fineliner/defs/fineliner-defs"
import { appearanceScript } from "@/fineliner/theme/appearance-script"
import { frameVars, seedOf } from "@/fineliner/pen"
import { Lettering } from "@/fineliner/drawing/lettering"
import { siteAppearance } from "@/site/appearance"
import { AppearancePanel } from "@/site/appearance-panel"
import FontPreloads from "@/site/font-preloads.astro"
import { shareFor } from "@/site/share/shares"
import { NAV, currentOf } from "./nav"
import SiteMenu from "./site-menu.astro"

interface Props {
  title: string
  description: string
}
const { title, description } = Astro.props
const fullTitle = title === "Fineliner" ? title : `${title} · Fineliner`
// The share image drawn for this page (src/pages/og), absolute once the site has a URL.
const shareImage = new URL(
  shareFor(Astro.url.pathname),
  Astro.site ?? Astro.url,
).href
const path = Astro.url.pathname.replace(/\/$/, "") || "/"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <FontPreloads />
    <title>{fullTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline set:html={appearanceScript(siteAppearance)} />
  </head>
  <body>
    <FinelinerDefs />
    <a
      class="label absolute -left-[999px] top-2 z-30 bg-pen px-tight py-hair text-paper focus:left-2"
      href="#main"
    >
      Skip to content
    </a>
    <!-- One row: the wordmark, then the nav and the appearance button at the end; on a phone the nav folds into the
         menu behind a burger after the button. -->
    <header class="mx-auto flex max-w-[76rem] items-center gap-x-snug px-snug pt-snug sm:px-line">
      <a class="block text-pen no-underline" href="/">
        <Lettering text="Fineliner" className="text-[1.75rem]" />
      </a>
      <nav aria-label="Site" class="ms-auto max-md:hidden">
        <ul class="m-0 flex list-none flex-wrap gap-x-snug gap-y-hair p-0">
          {NAV.map(({ href, label }) => (
            <li>
              <a
                class="text-small no-underline aria-[current=page]:underline"
                href={href}
                aria-current={currentOf(path, href)}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <AppearancePanel className="max-md:ms-auto" client:idle />
      <SiteMenu path={path} />
    </header>
    <div class="mx-auto max-w-[76rem] px-snug sm:px-line">
      <div
        class="rule mt-tight"
        style={frameVars(seedOf("header-rule"))}
        aria-hidden="true"
      ></div>
    </div>
    <main id="main">
      <slot />
    </main>
    <footer class="mx-auto mt-page max-w-[76rem] px-snug pb-line sm:px-line">
      <div
        class="rule mb-snug"
        style={frameVars(seedOf("footer-rule"))}
        aria-hidden="true"
      ></div>
      <p class="label m-0">Fineliner · MIT · drawn with one pen</p>
    </footer>
    <script>
      // Drawings rendered at build time carry their first take; this draws the others where line boil shows them.
      import { boilTakesIn } from "@/fineliner/drawing/drawing-takes"
      boilTakesIn(document, () =>
        Promise.all([
          import("@/fineliner/pen/objects"),
          import("@/fineliner/pen/objects/rooms"),
        ]),
      )
    </script>
  </body>
</html>
