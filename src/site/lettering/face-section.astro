---
// One face on the lettering page, introduced as the specimen's sections are: a rule, then in the first three of twelve
// columns its name, what it is, its files by style and the command that installs it; in the other nine, its four
// styles at one size, a letter's three versions side by side, and its letters and figures. Inline, the face drawn in
// two colours, has a pen and a fill to choose above its samples. The section is laid out only near the viewport
// (content-visibility), so its fonts load when it is about to be read.
import { Lettering } from "@/fineliner/drawing/lettering"
import { frameVars, seedOf } from "@/fineliner/pen"
import { FIGURES, LETTERS, STYLES, styleClass, type Face } from "./faces"
import { InlineColour } from "./inline-colour"

interface Props {
  face: Face
}
const { face } = Astro.props
const id = `face-${face.face}`
const files = (style: (typeof STYLES)[number]) =>
  face.fill
    ? [
        ["OTF", `${face.file}${style.file}.otf`],
        ["Fill OTF", `${face.fill}${style.file}.otf`],
      ]
    : [
        ["OTF", `${face.file}${style.file}.otf`],
        ["WOFF2", `${face.file}${style.file}.woff2`],
      ]
---

<section
  class="face mx-auto mt-page max-w-[76rem] px-snug sm:px-line"
  aria-labelledby={id}
>
  <div
    class="rule"
    style={frameVars(seedOf(`lettering-page-${face.face}`))}
    aria-hidden="true"
  ></div>
  <div class="grid gap-x-line gap-y-line pt-section lg:grid-cols-12">
    <header class="grid content-start gap-tight lg:col-span-3">
      <h2 id={id} class="m-0 text-h2 leading-heading">
        {face.short}
      </h2>
      <p class="m-0 max-w-measure text-small leading-small text-pen-quiet">
        {face.about}
      </p>
      <dl class="m-0 mt-tight grid grid-cols-[max-content_max-content] gap-x-snug gap-y-hair text-small leading-small">
        {STYLES.map((style) => (
          <div class="contents">
            <dt class="text-pen-quiet">{style.name}</dt>
            <dd class="m-0">
              {files(style).map(([label, file], i) => (
                <>
                  {i > 0 && " · "}
                  <a href={`/fonts/${file}`} download>
                    {label}
                  </a>
                </>
              ))}
            </dd>
          </div>
        ))}
      </dl>
      <p class="m-0 mt-tight text-small leading-small text-pen-quiet">
        Install with{" "}
        <code class="font-type text-pen">
          npx shadcn add{" "}
          {face.items
            .filter((item) => item !== "base")
            .map((item) => (
              <span class="whitespace-nowrap">@fineliner/{item}</span>
            ))
            .flatMap((item, i) => (i ? [" ", item] : [item]))}
        </code>
        {face.face === "line" && <> (the Regular comes with the kit's base)</>}.
        Free to use under the MIT licence.
      </p>
    </header>
    <div class="grid min-w-0 content-start gap-y-section lg:col-span-9">
      {face.fill && <InlineColour target={`${id}-samples`} client:visible />}
      <div id={`${id}-samples`} class="grid min-w-0 gap-y-section text-pen">
        <dl class="m-0 grid gap-y-tight">
          {STYLES.map((style) => (
            <div class="grid items-baseline gap-x-line gap-y-hair lg:grid-cols-9">
              <dt class="label text-pen-quiet lg:col-span-2">{style.name}</dt>
              <dd class="m-0 min-w-0 lg:col-span-7">
                <Lettering
                  text={face.sample}
                  face={face.face}
                  className={`block text-[clamp(2.5rem,7vw,4.5rem)] wrap-anywhere ${styleClass(style)}`}
                />
              </dd>
            </div>
          ))}
        </dl>
        <div class="grid items-center gap-x-line gap-y-tight lg:grid-cols-9">
          <p class="m-0 text-small leading-small text-pen-quiet lg:col-span-2">
            Each letter is drawn three times. Type the same letter again and the
            next version comes up, so repeats never look identical.
          </p>
          <Lettering
            text="MMM AAA"
            face={face.face}
            className="block text-[clamp(3rem,10vw,7rem)] leading-none lg:col-span-7"
          />
        </div>
        <dl class="m-0 grid gap-y-tight lg:grid-cols-9 lg:gap-x-line">
          {[
            ["Letters", LETTERS],
            ["Figures", FIGURES],
          ].map(([label, glyphs]) => (
            <div class="contents">
              <dt class="label text-pen-quiet lg:col-span-2 lg:pt-hair">
                {label}
              </dt>
              <dd class="m-0 lg:col-span-7">
                <Lettering
                  text={glyphs ?? ""}
                  face={face.face}
                  className="block text-[1.75rem] wrap-anywhere"
                />
              </dd>
            </div>
          ))}
        </dl>
      </div>
      <slot />
    </div>
  </div>
</section>

<style>
  /* Laid out only near the viewport, so a face's fonts load when it is about to be read. */
  .face {
    content-visibility: auto;
    contain-intrinsic-size: auto 70rem;
  }
</style>
