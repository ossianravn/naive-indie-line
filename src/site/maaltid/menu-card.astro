---
// The evening's menu as a printed card: each course's name in the label voice with a small drawing, then its dishes,
// the price set right after the dish's name on the typewriter, so the eye never travels to a far margin for it. The home
// page shows the first dish of each course; the menu page all of them.
import { Drawing } from "@/fineliner/drawing/drawing"
import { MENU, type Course } from "./data"

interface Props {
  courses?: Course[]
  /** Only the first dish of each course. */
  brief?: boolean
}
const { courses = MENU, brief = false } = Astro.props
---

<div class="grid gap-y-section">
  {courses.map((course) => (
    <section
      class="grid gap-x-line gap-y-snug sm:grid-cols-[9rem_minmax(0,34rem)]"
      aria-label={course.title}
    >
      <div class="flex items-center gap-snug sm:flex-col sm:items-start">
        <h3 class="label m-0 text-pen-quiet">{course.title}</h3>
        <Drawing
          object={course.object}
          seed={`maaltid-${course.object}`}
          title=""
          className="w-16 sm:w-24"
        />
      </div>
      <ul class="m-0 grid list-none content-start gap-y-snug p-0">
        {(brief ? course.dishes.slice(0, 1) : course.dishes).map((dish) => (
          <li>
            <p class="m-0 font-read text-lead leading-subhead">
              {dish.name}{" "}
              <span class="font-type text-small whitespace-nowrap text-pen-quiet">
                {dish.price}
              </span>
            </p>
            <p class="m-0 text-pen-quiet">{dish.with}</p>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>
