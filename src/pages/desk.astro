---
// The drawing desk: reroll any object or scene, then take its seed, JSX or SVG. The desk is a tool, so it opens on the
// drawing and its controls, with nothing above them: the nav says where the page sits, and the page's title is for
// screen readers. Lettering has its own page.
import Base from "@/site/layouts/base.astro"
import { Desk } from "@/site/desk/desk"
---

<Base
  title="Desk"
  description="Fineliner's drawing desk: choose an object or a scene, reroll the seed, and take the seed, JSX or SVG."
>
  <div class="mx-auto mt-line max-w-[76rem] px-snug sm:px-line">
    <h1 class="sr-only">Desk</h1>
    <Desk client:only="react" />
  </div>
</Base>
