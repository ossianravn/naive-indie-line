---
// The components index: every part by group, each a card with the part itself at rest, what it is for and a link to
// its states. The previews render on the server; the page ships no script of its own.
import Base from "@/site/layouts/base.astro"
import PageHeader from "@/site/layouts/page-header.astro"
import { GROUPS } from "@/site/docs/catalogue"
import { GalleryCard } from "@/site/docs/gallery/gallery-card"
---

<Base
  title="Components"
  description="Every Fineliner component, with its states and the command that installs it."
>
  <PageHeader title="Components">
    shadcn/ui's parts with shadcn's names, props and data-slots, built on Base
    UI and drawn with one pen. Start from a whole page in{" "}
    <a href="/docs/blocks">Blocks</a>.
  </PageHeader>
  <div class="mx-auto max-w-[76rem] px-snug pb-page sm:px-line">
    {GROUPS.map(({ group, items }) => (
      <section class="mt-section" aria-labelledby={`g-${group}`}>
        <h2 id={`g-${group}`} class="m-0 mb-snug text-h2">
          {group}
        </h2>
        <ul class="m-0 grid list-none gap-x-line gap-y-section p-0 md:grid-cols-2 xl:grid-cols-3">
          {items.map((item) => (
            <li class="min-w-0">
              <GalleryCard name={item.name} />
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
