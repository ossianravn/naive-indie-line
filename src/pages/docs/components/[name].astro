---
// One component's docs page: the shared page head with the install command, the component's states in one column of
// a fixed width, then previous and next; from lg the nav of every component runs beside it.
import Base from "@/site/layouts/base.astro"
import PageHeader from "@/site/layouts/page-header.astro"
import ComponentNav from "@/site/docs/component-nav.astro"
import ComponentPager from "@/site/docs/component-pager.astro"
import { DemoHost } from "@/site/docs/demo-host"
import type { DemoMeta } from "@/site/docs/demo-kit"
import { InstallCommand } from "@/site/docs/install-command"

export function getStaticPaths() {
  const modules = import.meta.glob<{ meta: DemoMeta }>(
    "../../../site/docs/demos/*.tsx",
    { eager: true },
  )
  return Object.entries(modules).map(([path, mod]) => ({
    params: { name: path.replace(/^.*\/(.+)\.tsx$/, "$1") },
    props: { meta: mod.meta },
  }))
}

const name = Astro.params.name ?? ""
const { meta } = Astro.props
---

<Base title={meta.title} description={meta.description}>
  <div class="mx-auto grid max-w-[76rem] gap-x-page px-snug sm:px-line lg:grid-cols-[minmax(0,1fr)_12rem]">
    <div class="min-w-0">
      <PageHeader title={meta.title} contained={false}>
        <Fragment slot="kicker">
          <a href="/docs">Components</a> · {meta.group ?? "Other"}
        </Fragment>
        {meta.description}
      </PageHeader>
      <InstallCommand
        command={`npx shadcn add @fineliner/${meta.item}`}
        className="mt-snug"
        client:visible
      />
      <div class="mt-section">
        <DemoHost name={name} client:load />
      </div>
      <ComponentPager current={name} />
    </div>
    <ComponentNav current={name} />
  </div>
</Base>
