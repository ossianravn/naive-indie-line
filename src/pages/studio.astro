---
import Base from "@/site/layouts/base.astro"
import PageHeader from "@/site/layouts/page-header.astro"
import { Studio } from "@/site/studio/studio"
---

<Base
  title="Theme studio"
  description="Paper, pen, hand, line boil, containers, labels and density, on the shop's own screens and every kind of part at once, exported as CSS or a shadcn registry item."
>
  <PageHeader title="Theme studio">
    Choose the paper, the pen and the hand, watch them land on the shop's
    dashboard and every kind of part, then take the theme away as CSS or a
    shadcn item.
  </PageHeader>
  <div class="mx-auto mt-section max-w-[76rem] px-snug pb-page sm:px-line">
    <Studio client:load />
  </div>
</Base>
