---
// Home: the language at its best, and installing within a minute. The hero is the kit's hero-01 block; the rest render
// at build time, with islands only where something moves or is chosen.
import Base from "@/site/layouts/base.astro"
import { Hero01 } from "@/fineliner/blocks/hero-01"
import ComponentIndex from "@/site/home/component-index.astro"
import Drawings from "@/site/home/drawings.astro"
import InUse from "@/site/home/in-use.astro"
import Install from "@/site/home/install.astro"
---

<Base
  title="Fineliner"
  description="A shadcn/ui kit drawn with one fine-liner on unbleached paper: frames, marks and drawings of objects, rooms and people, installed from its own registry."
>
  <!-- The open room fills the first screen below the site's header (--hero-top, its height). -->
  <Hero01 className="[--hero-top:5rem]" client:load />
  <Drawings />
  <InUse />
  <ComponentIndex />
  <Install />
</Base>
