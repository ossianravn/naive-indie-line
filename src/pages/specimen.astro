---
// The specimen: Fineliner's materials on one sheet, in the order they build on each other: paper, the pen, its line,
// its words, its letters, its drawings, and the shop they run. Every section shares one twelve-column grid and is
// introduced the same way (src/site/specimen/sheet-section.astro); src/site/specimen/sheet.ts lists them.
import Base from "@/site/layouts/base.astro"
import { Drawing } from "@/fineliner/drawing/drawing"
import Drawings from "@/site/specimen/drawings.astro"
import InUse from "@/site/specimen/in-use.astro"
import Lettering from "@/site/specimen/lettering.astro"
import Lines from "@/site/specimen/lines.astro"
import Paper from "@/site/specimen/paper.astro"
import Pens from "@/site/specimen/pens.astro"
import Title from "@/site/specimen/title.astro"
import Voices from "@/site/specimen/voices.astro"
---

<Base
  title="Specimen"
  description="A shadcn/ui kit drawn with one fine-liner on unbleached paper: the specimen of its paper, pens, line, voices, lettering and drawings, and the components they make."
>
  <Title />
  <Paper />
  <Pens />
  <Lines />
  <Voices />
  <Lettering />
  <Drawings />
  <InUse />
  <div class="mx-auto mt-page max-w-[76rem] px-snug sm:px-line">
    <div class="grid gap-x-line lg:grid-cols-12">
      <div class="flex items-end gap-snug lg:col-span-9 lg:col-start-4">
        <Drawing
          object="cat"
          seed="colophon"
          title=""
          className="w-16 shrink-0"
        />
        <p class="m-0 max-w-measure text-small leading-small text-pen-quiet">
          Set in Newsreader and Courier Prime and drawn with one pen. Every line
          on this sheet comes from a seed, so it prints the same tomorrow.
        </p>
      </div>
    </div>
  </div>
</Base>
