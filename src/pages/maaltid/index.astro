---
// MÅLTID's front page: what the restaurant is beside its dining room, tonight's menu in brief, three wines by the
// glass and where the food comes from. Sections put their heading in the first four of twelve columns and their
// content in the rest, like a printed programme.
import Layout from "@/site/maaltid/layout.astro"
import { MenuCard } from "@/site/maaltid/menu-card"
import { Drawing } from "@/fineliner/drawing/drawing"
import { TastingNote } from "@/fineliner/extras/tasting-note"
import { frameStyle } from "@/fineliner/lib/frame-style"
import { buttonVariants } from "@/fineliner/ui/button"
import {
  PLACE,
  SET_MENU,
  SOURCES,
  TONIGHT,
  WINES,
  kr,
} from "@/site/maaltid/data"

const byTheGlass = WINES.filter((w) => w.glass && !w.soldOut).slice(0, 4)
const section =
  "mx-auto mt-page grid max-w-[76rem] gap-x-line gap-y-line px-snug sm:px-line lg:grid-cols-12"
---

<Layout description="MÅLTID: peasant food from Italy, cooked in the north, and natural wine from small growers. Nørrebro, København.">
  <div class="mx-auto mt-section grid max-w-[76rem] items-center gap-x-page gap-y-section px-snug sm:px-line lg:grid-cols-12">
    <div class="grid content-start gap-y-snug lg:col-span-5">
      <p class="label m-0 text-pen-quiet">{PLACE.city}</p>
      <h1 class="m-0 text-display leading-heading">
        Peasant food from Italy, cooked in the north.
      </h1>
      <p class="m-0 max-w-measure text-lead leading-lead text-pen-quiet">
        Bread, beans, greens and whatever the boats bring in, cooked the way
        people cook when they have little. Natural wine from small growers.
      </p>
      <div class="mt-tight flex flex-wrap items-center gap-x-line gap-y-snug">
        <a
          href="/maaltid/book"
          data-slot="button"
          class={buttonVariants({ className: "no-underline" })}
          style={frameStyle(["Book a table"])}
        >
          Book a table
        </a>
        <a href="/maaltid/menu">Tonight's menu</a>
      </div>
      <p class="m-0 mt-tight text-small leading-small text-pen-quiet">
        {PLACE.hours} · {PLACE.kitchen.toLowerCase()}
      </p>
    </div>
    <Drawing
      scene="maaltid"
      seed="maaltid-home"
      drawOnView
      className="lg:col-span-7"
    />
  </div>

  <section class={section} aria-labelledby="tonight">
    <header class="grid content-start gap-tight lg:col-span-4">
      <h2 id="tonight" class="m-0 text-h1 leading-heading">
        Tonight
      </h2>
      <p class="label m-0 text-pen-quiet">{TONIGHT.label}</p>
      <p class="m-0 max-w-measure text-small leading-small text-pen-quiet">
        The menu changes with what comes in. The whole of it for the table is{" "}
        {kr(SET_MENU.food)} a person, and wine with it {kr(SET_MENU.wine)}.
      </p>
    </header>
    <div class="grid gap-y-line lg:col-span-8">
      <MenuCard brief />
      <p class="m-0">
        <a href="/maaltid/menu">The whole menu</a>
      </p>
    </div>
  </section>

  <section class={section} aria-labelledby="glass">
    <header class="grid content-start gap-tight lg:col-span-4">
      <h2 id="glass" class="m-0 text-h1 leading-heading">
        In the glass
      </h2>
      <p class="m-0 max-w-measure text-small leading-small text-pen-quiet">
        Natural wine from small growers: nothing added, little taken away. These
        four are poured by the glass tonight.
      </p>
    </header>
    <div class="grid gap-y-line lg:col-span-8">
      <div class="grid gap-x-line gap-y-section md:grid-cols-2">
        {byTheGlass.map((w) => (
          <TastingNote
            name={w.name}
            producer={w.producer}
            grape={w.grape}
            region={w.region}
            year={w.year}
            price={kr(w.bottle)}
            glass={w.glass ? kr(w.glass) : undefined}
            vessel={w.vessel}
          >
            {w.note}
          </TastingNote>
        ))}
      </div>
      <p class="m-0">
        <a href="/maaltid/wine">The wine list</a>
      </p>
    </div>
  </section>

  <section class={section} aria-labelledby="sources">
    <header class="grid content-start gap-tight lg:col-span-4">
      <h2 id="sources" class="m-0 text-h1 leading-heading">
        Where it comes from
      </h2>
      <p class="m-0 max-w-measure text-small leading-small text-pen-quiet">
        Most of it from within a few hours of the kitchen.
      </p>
    </header>
    <ul class="m-0 grid list-none grid-cols-2 gap-x-line gap-y-section p-0 sm:grid-cols-3 lg:col-span-8">
      {SOURCES.map((s) => (
        <li class="grid content-start gap-y-tight">
          <Drawing
            object={s.object}
            seed={`maaltid-source-${s.object}`}
            title=""
            className="[&>svg]:h-24 [&>svg]:w-auto [&>svg]:max-w-full"
          />
          <p class="m-0 font-read text-lead leading-subhead">{s.what}</p>
          <p class="m-0 text-small leading-small text-pen-quiet">{s.where}</p>
        </li>
      ))}
    </ul>
  </section>
</Layout>
