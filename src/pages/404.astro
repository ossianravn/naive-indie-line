---
// Not found: said plainly, with the way back. nginx serves it for any missing path.
import Base from "@/site/layouts/base.astro"
import PageHeader from "@/site/layouts/page-header.astro"
import { Drawing } from "@/fineliner/drawing/drawing"
---

<Base title="Page not found" description="There is no page at this address.">
  <PageHeader title="Nothing drawn here">
    <Fragment slot="kicker">404 · Not found</Fragment>
    The address may be old or mistyped. Start again from the{" "}
    <a href="/">home page</a>, or go straight to the{" "}
    <a href="/docs">components</a>.
    <Drawing
      slot="aside"
      object="crate"
      seed="lost-record"
      title=""
      className="mx-auto w-full max-w-[12rem] md:max-w-none"
    />
  </PageHeader>
</Base>
