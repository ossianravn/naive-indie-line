---
// Lettering: the pen's three typefaces with room to show them. A tester first (your words in any face, style, size and
// pen, the one island), then a section per face with its four styles, its takes, its letters and its files, Inline's
// colours, and the set all three share. Face sections are laid out only near the viewport, so a phone fetches a
// face's fonts when it is about to be read rather than all sixteen files at once.
import Base from "@/site/layouts/base.astro"
import { Lettering } from "@/fineliner/drawing/lettering"
import { frameVars, seedOf } from "@/fineliner/pen"
import { FACES, SHARED } from "@/site/lettering/faces"
import FaceSection from "@/site/lettering/face-section.astro"
import Pairings from "@/site/lettering/pairings.astro"
import { LetteringTester } from "@/site/lettering/tester"
---

<Base
  title="Lettering"
  description="Fineliner Naïve Sans, Inline and Tramline: three typefaces drawn from the pen's own alphabet, each in Regular, Bold, Italic and Bold Italic, with three takes of every letter. MIT."
>
  <div class="mx-auto max-w-[76rem] px-snug pt-section sm:px-line">
    <p class="label m-0 text-pen-quiet">Fineliner · Lettering</p>
    <h1 class="m-0 mt-tight">
      <Lettering
        text="Lettering"
        face="inline"
        className="block text-[clamp(3.5rem,11vw,7.5rem)] leading-none"
      />
    </h1>
    <p class="m-0 mt-snug max-w-measure text-lead leading-lead max-sm:text-body max-sm:leading-body">
      Three typefaces drawn from the pen's own alphabet, each in Regular, Bold,
      Italic and Bold Italic. Capitals for every Latin-script language in
      Europe, three takes of every letter, MIT.
    </p>
    <div class="mt-section">
      <LetteringTester client:idle />
    </div>
  </div>

  {FACES.map((face, i) => (
    <FaceSection face={face} n={i + 1}>
      {face.face === "inline" && <Pairings />}
    </FaceSection>
  ))}

  <section
    class="shared mx-auto mt-page max-w-[76rem] px-snug sm:px-line"
    aria-labelledby="shared"
  >
    <div
      class="rule"
      style={frameVars(seedOf("lettering-page-shared"))}
      aria-hidden="true"
    ></div>
    <div class="grid gap-x-line gap-y-line pt-section lg:grid-cols-12">
      <header class="grid content-start gap-tight lg:col-span-3">
        <p class="label m-0 text-pen-quiet">Nº 04</p>
        <h2 id="shared" class="m-0 text-h2 leading-heading">
          The set they share
        </h2>
        <p class="m-0 max-w-measure text-small leading-small text-pen-quiet">
          All three draw the same 197 characters, for every Latin-script
          language in Europe; lowercase types the capitals.
        </p>
      </header>
      <dl class="m-0 grid min-w-0 content-start gap-y-tight lg:col-span-9 lg:grid-cols-9 lg:gap-x-line">
        {SHARED.map(([label, glyphs]) => (
          <div class="contents">
            <dt class="label text-pen-quiet lg:col-span-2 lg:pt-hair">
              {label}
            </dt>
            <dd class="m-0 lg:col-span-7">
              <Lettering
                text={glyphs}
                className="block text-[1.75rem] leading-[1.35] wrap-anywhere"
              />
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Base>

<style>
  .shared {
    content-visibility: auto;
    contain-intrinsic-size: auto 30rem;
  }
</style>
