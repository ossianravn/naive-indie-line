---
// The object library's front page: each collection with six of its drawings and a way into the rest. A collection's
// own page (drawings/[collection].astro) shows all of it, so no page draws the whole library at once.
import Base from "@/site/layouts/base.astro"
import PageHeader from "@/site/layouts/page-header.astro"
import ObjectGrid from "@/site/drawings/object-grid.astro"
import { COLLECTION_PAGES } from "@/site/drawings/collections"

const seed = "library"
---

<Base
  title="Drawings"
  description="Fineliner's object library: every drawing by collection, each drawn by the pen from a seed."
>
  <PageHeader title="Drawings">
    Every object the pen draws, by collection, each from a seed. The library
    keeps growing; the <a href="/desk">desk</a> rerolls any of them, and the{" "}
    <a href="/drawings/skill">drawing skill</a> draws the ones your project
    needs.
  </PageHeader>
  <div class="mx-auto max-w-[76rem] px-snug pb-page sm:px-line">
    {COLLECTION_PAGES.map((c) => (
      <section class="mt-page" aria-labelledby={`c-${c.key}`}>
        <h2 id={`c-${c.key}`} class="m-0 text-h2">
          <a href={c.href} class="no-underline hover:underline">
            {c.title}
          </a>
        </h2>
        <p class="m-0 mt-tight max-w-measure text-pen-quiet">{c.lead}</p>
        <div class="mt-line">
          <ObjectGrid
            objects={c.objects.filter((o) => c.picks.includes(o.id))}
            seed={seed}
          />
        </div>
        <p class="m-0 mt-line">
          <a href={c.href}>
            All {c.objects.length} {c.title.toLowerCase()} drawings
          </a>
        </p>
      </section>
    ))}
  </div>
</Base>
